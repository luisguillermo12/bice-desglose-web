/**
 * 0.001
 */
DEFAULT_MIN_DESG = 0
/**
 * 999.999
 */
DEFAULT_MAX_DESG = 1000

DEFAULT_MIN_IVA = 0
DEFAULT_MAX_IVA = 1

MONTH_NUMBER_MAX = 12
MONTH_NUMBER_MIN = 1

/**
 * Representa la tabla "DESGLO" que contiene desglose individuales o consolidado para las distintas monedas. Pertenece al esquema CIF_ADMIN.
 * @author Antonio Marrero Palomino
 */
entity Desglose {
	/**
	 * Rut de cliente.
	 */
	codCliente String required,
	/**
	 * Tipo de desglose.
	 */
	codTipoDes Integer required,
	/**
	 * Subtipo de desglose.
	 */
	codSubtipoDes Integer required,
	/**
	 * Código de moneda.
	 */
	codMoneda String required,
	/**
	 * Unidad monetaria.
	 */
	codUnidMoneda String required,
	/**
	 * Descripción para Subtipo de desglose.
	 */
	glsSubtipoDes String,
	/**
	 * Valor deflactor base. Precisión 6, escala 3.
	 */
	valDeflacBase BigDecimal required min(DEFAULT_MIN_DESG) max(DEFAULT_MAX_DESG),
	/**
	 * Valor IVA. Precisión 4, escala 3.
	 */
	valIva BigDecimal required min(DEFAULT_MIN_IVA) max(DEFAULT_MAX_IVA),
	/**
	 * Login de último usuario que guarda desglose.
	 */
	nomUserAnalis String required,
	/**
	 * Observación para el Desglose ingresada en configuración de desglose.
	 */
	glsObservacion String,
	/**
	 * Login de usuario que crea desglose.
	 */
	nomUserCrea String required,
	/**
	 * Fecha de creación de desglose.
	 */
	fecUserCrea LocalDate required,
	/**
	 * Login de usuario que modifica desglose.
	 */
	nomUserModif String,
	/**
	 * Fecha de modificación de desglose.
	 */
	fecUserModif LocalDate,
	/**
	 * Fecha asociada al deflactor base.
	 */
	fecDeflacBase LocalDate required,
	/**
	 * Login de usuario que tiene abierto o cargado el desglose.
	 */
	nomUserOpen String,
	/**
	 * Flag que indica si el desglose es temporal o no.
	 */
	flgIsTemporal Boolean required,
	/**
	 * Código de moneda de impresión.
	 */
	codMonedaImp String required,
	/**
	 * Fecha y hora desde que está abierto o cargado el desglose.
	 */
	fecHraOpen LocalDate,
	/**
	 * Nombre del usuario que tiene abierto o cargado el desglose.
	 */
	nomUser String,
	/**
	 * Flag que señala resultado de validación. OK o NOK.
	 */
	flgValidacion String,
	/**
	 * Flag que señala condicion de revision. AREV o ENREV.
	 */
	flgRevision String,
	/**
	 * Comentario producto de la validación.
	 */
	glsComentValid String,
	/**
	 * Estado del desglose.
	 */
	codEstado String,
	/**
	 * Rol empleado que lleva desglose a estado definitivo.
	 */
	rolEmpleadoDesDef String,
	/**
	 * Nombre de revisor que lleva desglose a estado definitivo.
	 */
	nomRevisorDef String,
	/**
	 * Fecha en que desglose se lleva a estado definitivo.
	 */
	fecDesgloDef LocalDate,
	/**
	 * Rol empleado de revisor que revisó y modificó desglose.
	 */
	rolEmpleadoRevMod String,
	/**
	 * Rol empleado que genera PDF para desglose.
	 */
	rolEmpleadoDefEnvPdf String,
	/**
	 * Fecha de envío del PDF.
	 */
	fecDesgloEnvPdf LocalDate,
	/**
	 * Código moneda impresión (se usa como parámetro).
	 */
	codMonedaRpt Integer,
	/**
	 * Correlativo de impresión (se usa como parámetro).
	 */
	corImpresionRpt Integer,
	/**
	 * Flag que señala si es ejecutivo de factoring o no (se usa como parámetro).
	 */
	flgEjeFactoringRpt String,
	/**
	 * Fecha período 1 (se usa como parámetro).
	 */
	fecPeriodo1Rpt LocalDate,
	/**
	 * Fecha período 2 (se usa como parámetro).
	 */
	fecPeriodo2Rpt LocalDate,
	/**
	 * Fecha período 3 (se usa como parámetro).
	 */
	fecPeriodo3Rpt LocalDate,
	/**
	 * Fecha período 4 (se usa como parámetro).
	 */
	fecPeriodo4Rpt LocalDate,
	/**
	 * Fecha período Consolidado 1 (se usa como parámetro).
	 */
	fecPerConsol1Rpt LocalDate,
	/**
	 * Fecha período consolidado 2 (se usa como parámetro).
	 */
	fecPerConsol2Rpt LocalDate,
	/**
	 * Fecha último período 1 (se usa como parámetro).
	 */
	fecUlt1Rpt LocalDate,
	/**
	 * Fecha último período 2 (se usa como parámetro).
	 */
	fecUlt2Rpt LocalDate,
	/**
	 * Fecha de aprobación desglose (se usa como parámetro).
	 */
	fecUserModifRpt LocalDate,
	/**
	 * Nombre aprobador de desglose (se usa como parámetro).
	 */
	nomUserModifRpt String,
	/**
	 * Número de plantilla de reporte (se usa como parámetro).
	 */
	numReporteRpt Integer,
	/**
	 * Fecha generación del reporte (se usa como parámetro).
	 */
	fecGeneracionRpt LocalDate,
	/**
	 * Contador que señala las veces en que desglose es enviado a revisión.
	 */
	numDevolEjecutor Integer,
	/**
	 * Rol empleado que produce cambio de estado a desglose.
	 */
	numRolChgEstado String,
	/**
	 * Flag que señala si falta segunda firma o no.
	 */
	flgReq2firma String
}
/**
 * Representa la tabla "PERIOD" que contiene información para períodos del desglose. Pertenece al esquema CIF_ADMIN.
 * @author Antonio Marrero Palomino
 */
entity Periodo {
	/**
	 * Rut de cliente.
	 */
	codCliente String required,
	/**
	 * Tipo de desglose.
	 */
	codTipoDes Integer required,
	/**
	 * Subtipo de desglose.
	 */
	codSubtipoDes Integer required,
	/**
	 * Código de moneda.
	 */
	codMoneda String required,
	/**
	 * Fecha para el período.
	 */
	fecPeriodo LocalDate required,
	/**
	 * Cantidad de meses asociadas al período. Valor entre 1 y 12, ambos inclusive.
	 */
	numMeses Integer required min(MONTH_NUMBER_MIN) max(MONTH_NUMBER_MAX),
	/**
	 *  Valor deflator para el período. Precisión 6, escala 3. Valor entre 1 y 1000, sin incluir ambos.
	 */
	valDeflacPrd BigDecimal required min(DEFAULT_MIN_DESG) max(DEFAULT_MAX_DESG),
	/**
	 * Código empresa auditora.
	 */
	codAuditor String,
	/**
	 * Descripción de otra auditora.
	 */
	glsOtrosAudit String,
	/**
	 * Estado del período. Valores permitidos (0, 1, 2).
	 */
	codEstadoPrd Integer required,
	/**
	 * Estado de la auditoría. Valores permitidos (0, 1, 2).
	 */
	codEstadoAudi Integer required,
	/**
	 * Valor deuda directa vigente. Precisión 17, escala 2.
	 */
	mtoSbifDdVig BigDecimal,
	/**
	 * Valor deuda directa morosa. Precisión 17, escala 2.
	 */
	mtoSbifDdMor BigDecimal,
	/**
	 * Valor deuda directa vencida. Precisión 17, escala 2.
	 */
	mtoSbifDdVen BigDecimal,
	/**
	 * Valor deuda directa castigada. Precisión 17, escala 2.
	 */
	mtoSbifDdCas BigDecimal,
	/**
	 * Valor deuda indirecta vigente. Precisión 17, escala 2.
	 */
	mtoSbifDiVig BigDecimal,
	/**
	 * Valor deuda indirecta vencida. Precisión 17, escala 2.
	 */
	mtoSbifDiVen BigDecimal,
	/**
	 * Valor deuda indirecta castigada. Precisión 17, escala 2.
	 */
	mtoSbifDiCas BigDecimal,
	/**
	 * Login usuario que crea período.
	 */
	nomUserCrea String required,
	/**
	 * Fecha de creación del período.
	 */
	fecUserCrea LocalDate required,
	/**
	 * Login usuario que modifica período.
	 */
	nomUserModif String,
	/**
	 * Fecha de modificación del período.
	 */
	fecUserModif LocalDate,
	/**
	 * Fecha de actualización deudas SBIF.
	 */
	fecInformSbif LocalDate,
	/**
	 * Valor tipo de cambio. Precisión 12, escala 6.
	 */
	valTipoCambio BigDecimal required,
	/**
	 * Valor deuda impaga entre 90 y 180 días. Precisión 17, escala 2.
	 */
	mtoSbifImp90179 BigDecimal
}
/**
 * Representa la tabla "VALPRD_WK" que contiene detalle de valores asociada a las distintas cuentas y períodos de cada desglose. Pertenece al esquema CIF_ADMIN.
 * @author Antonio Marrero Palomino
 */
entity ValPeriodoDesglose {
	/**
	 * Rut de cliente.
	 */
	codCliente String required,
	/**
	 * Tipo de desglose.
	 */
	codTipoDes Integer required,
	/**
	 * Subtipo de desglose.
	 */
	codSubtipoDes Integer required,
	/**
	 * Código de moneda.
	 */
	codMoneda String required,
	/**
	 * Fecha para el período.
	 */
	fecPeriodo LocalDate required,
	/**
	 * Tipo de concepto.
	 */
	codTipoConcep String required,
	/**
	 * Correlativo para concepto.
	 */
	corConcepto Integer required,
	/**
	 * Correlativo que aplica para multiregistro, de lo contrario siempre es cero.
	 */
	corValor Integer required,
	/**
	 * Valor asociado al concepto o cuenta. Precisión 17, escala 3.
	 */
	valConcepto BigDecimal,
	/**
	 * Fórmula asociada a la celda, solo cuando se ingresa valor expresado en fórmula.
	 */
	glsFrmlConcep String,
	/**
	 * Descripción del concepto que aplica para los multiregistros.
	 */
	glsConcepto String,
	/**
	 * Valor porcentual asociado a la cuenta. Precisión 4, escala 3.
	 */
	valPrcConcep BigDecimal
}
/**
 * Representa la tabla "VALIMP_WK" que contiene detalle de valores asociada a las distintas cuentas y períodos de cada desglose generado para la impresión. Pertenece al esquema
 CIF_ADMIN.
 * @author Antonio Marrero Palomino
 */
entity ValPeriodoDesgImpr {
	/**
	 * Rut de cliente.
	 */
	codCliente String required,
	/**
	 * Tipo de desglose.
	 */
	codTipoDes Integer required,
	/**
	 * Subtipo de desglose.
	 */
	codSubtipoDes Integer required,
	/**
	 * Código de moneda.
	 */
	codMoneda String required,
	/**
	 * Código de moneda de impresión.
	 */
	codMonedaImp String required,
	/**
	 * Fecha para el período.
	 */
	fecPeriodo LocalDate required,
	/**
	 * Tipo de concepto.
	 */
	codTipoConcep String required,
	/**
	 * Correlativo para concepto.
	 */
	corConcepto Integer required,
	/**
	 * Correlativo que aplica para multiregistro, de lo contrario siempre es cero.
	 */
	corValor Integer required,
	/**
	 * Valor asociado al concepto o cuenta. Precisión 17, escala 3.
	 */
	valConcepto BigDecimal required,
	/**
	 * Correlativo de impresión.
	 */
	corImpreso Integer required
}
/**
 * Representa la tabla "CONSOL_WK" que contiene empresas consolidadas para un desglose consolidado. Pertenece al esquema CIF_ADMIN.
 * @author Antonio Marrero Palomino
