	/**
	 * Subtipo de desglose.
	 */
	codSubtipoDes Integer required,
	/**
	 * Código de moneda.
	 */
	codMoneda String required,
	/**
	 * Correlativo para diferencia una empresa de otra dentro del consolidado.
	 */
	corEmpresa Integer required,
	/**
	 * Nombre de la empresa consolidada.
	 */
	nomEmpresa String required
}
