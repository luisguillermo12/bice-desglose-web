<?xml version="1.0" encoding="utf-8"?>
<project name="GenerateReportsJar" default="dist" basedir=".">
    <description>
        Empaqueta clases en un jar.
    </description>
    <!-- set global properties for this build -->
    <!--<property name="src" location="../src/main/java/cl/tutorial/desglose/service/dto/report"/>-->
    <property name="src" location="../src/main/java"/>
    <!--<property name="build" location="../build"/>-->
    <!--<property name="build" location="../target/classes/cl/tutorial/desglose/service/dto/report"/>-->
    <property name="build" location="../target/classes"/>
    <property name="dist" location="../dist/jasper_report"/>
    <property name="version" value="1.0
"/>

    <target name="init">
        <!-- Create the time stamp -->
        <!--<tstamp/>-->
        <!-- Create the build directory structure used by compile -->
        <mkdir dir="${build}"/>
        <delete dir="${dist}"/>
    </target>

    <target name="compile" depends="init" description="compile the source">
        <!-- Compile the java code from ${src} into ${build} -->
        <javac srcdir="${src}" destdir="${build}"/>
    </target>

    <!--<target name="dist" depends="compile" description="generate the distribution">-->
    <target name="dist" description="generate the distribution from IDE compilation">
        <!--<buildnumber/>-->
        <!-- Create the distribution directory -->
        <mkdir dir="${dist}/lib"/>

        <!-- Put everything in ${build} into the MyApplication-${version}.${build.number}.jar -->
        <!--<jar destfile="${dist}/lib/desglose-reports-beans-${version}.${build.number}.jar" basedir="${build}">-->
        <jar destfile="${dist}/lib/desglose-reports-beans-${version}.0.jar">
            <fileset dir="${build}">
                <include name="cl/tutorial/desglose/service/dto/report/*.class"/>
                <!--<include name="../../src/main/java/cl/tutorial/desglose/service/dto/report/*.java"/>-->
            </fileset>
            <!--<fileset dir="${build}" />-->
            <!--<fileset dir="${src}" includes="**/*.java"/>-->
            <fileset dir="${src}" includes="cl/tutorial/desglose/service/dto/report/*.java"/>
        </jar>
        <!--<jar destfile="${dist}/lib/desglose-reports-beans-${version}.${build.number}.jar" basedir="${build}"/>-->
    </target>

    <target name="clean" description="clean up">
        <!-- Delete the ${build} and ${dist} directory trees -->
        <delete dir="${build}"/>
        <delete dir="${dist}"/>
    </target>
</project>
