<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.5.xsd">
    <!--
        Added the constraints for entity TurbineUserGroupRole.
    -->
    <changeSet id="20181022174827-2" author="jhipster">
        
        <addForeignKeyConstraint baseColumnNames="user_id"
                                 baseTableName="tugr"
                                 constraintName="turbine_user_g_user_id"
                                 referencedColumnNames="id"
                                 referencedTableName="turbine_user"/>

        <addForeignKeyConstraint baseColumnNames="group_id"
                                 baseTableName="tugr"
                                 constraintName="turbine_user_g_group_id"
                                 referencedColumnNames="id"
                                 referencedTableName="turbine_group"/>

        <addForeignKeyConstraint baseColumnNames="role_id"
                                 baseTableName="tugr"
                                 constraintName="turbine_user_g_role_id"
                                 referencedColumnNames="id"
                                 referencedTableName="turbine_role"/>

    </changeSet>
</databaseChangeLog>
