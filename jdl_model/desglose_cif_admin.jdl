	codMoneda String required,
	/**
	 * Tipo de concepto.
	 */
	codTipoConcep String required,
	/**
	 * Correlativo para concepto.
	 */
	corConcepto Integer required
}
/**
 * Representa la tabla "PRCCNS_WK" que contiene los períodos de un desglose consolidado. Pertenece al esquema CIF_ADMIN.
