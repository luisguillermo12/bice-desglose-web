	 */
	codMoneda String required,
	/**
	 * Correlativo para diferenciar una empresa de otra dentro del consolidado.
	 */
	corEmpresa Integer required,
	/**
	 * Fecha para el período.
	 */
	fecPeriodo LocalDate required,
	/**
	 * Valor porcentual asociado a la empresa dentro del consolidado. Precisión 5, escala 4.
	 */
	valPrcConsol BigDecimal required
}
/**
 * Representa la tabla "PRDIMP_WK" que contiene información para períodos del desglose generado para la impresión. Pertenece al esquema CIF_ADMIN.
